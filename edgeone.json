{
  "name": "resume-builder",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "nodeVersion": "22.11.0",
  "rewrites": [
    {
      "source": "/*",
      "destination": "/index.html"
    }
  ],
  "cloudFunctions": {
    "maxDuration": 10,
    "regions": {
      "mainland": ["ap-guangzhou"]
    }
  }
}